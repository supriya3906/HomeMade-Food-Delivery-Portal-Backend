# Which database to use:
#   mysql  = MySQL / MariaDB (XAMPP) - the real database for this project
#   sqlite = one file, nothing to install (quick try-out)
#   file   = plain JSON file
DB_TYPE=mysql

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=rasoi

# Long random text used to sign login tokens (JWT). Change it.
AUTH_SECRET=change-me-to-a-long-random-string

# Real "Continue with Google": paste your OAuth Web client id (see README).
GOOGLE_CLIENT_ID=

# The administrator account, created on first start. Open /admin/login to sign in.
ADMIN_EMAIL=admin@rasoi.com
ADMIN_PASSWORD=ChangeMe@123

# ---- Operations (admin dashboard, dispatch, payments) --------------------------------
# AUTO_ASSIGN=on  -> when food is ready and nobody is assigned, the system assigns the recommended
#                    (nearest suitable) partner. AUTO_ASSIGN=off -> orders wait for the admin to assign.
AUTO_ASSIGN=on
# "Today" / daily revenue use this UTC offset in minutes (330 = India).
BUSINESS_TZ_OFFSET_MIN=330
# Sandbox payment gateway timings (milliseconds spent in "processing" and "verification").
PAY_PROCESSING_MS=2500
PAY_VERIFY_MS=2500
